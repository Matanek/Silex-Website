<article class="package-card">
    <div class="package-card-meta">
        {% if package.repository %}
            <a class="package-card-repository" href="{{ package.repository }}" aria-label="{{ package.name }} — {{ locale == 'fr' ? 'ouvrir le dépôt' : 'open repository' }}">{{ package.name }}</a>
        {% else %}
            <span class="package-card-name">{{ package.name }}</span>
        {% endif %}
    </div>
    <p>{{ package.description }}</p>
    {% if package.documentation is defined and package.documentation %}
    <div class="package-card-footer">
        <div class="package-card-links">
            <a class="package-card-documentation" href="{{ package.documentation }}">Documentation <span aria-hidden="true">→</span></a>
        </div>
    </div>
    {% endif %}
</article>
