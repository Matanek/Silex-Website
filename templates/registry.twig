{% extends 'layout.twig' %}

{% block title %}Silex Registry — {{ locale == 'fr' ? 'Construisez. Publiez. Partagez.' : 'Build. Release. Share.' }}{% endblock %}
{% block description %}{{ locale == 'fr' ? 'Découvrez le registre public des packages Silex et apprenez à publier votre package.' : 'Discover the public Silex package registry and learn how to publish your package.' }}{% endblock %}
{% block body_class %}registry-page{% endblock %}

{% block content %}
<section class="registry-hero-section" aria-labelledby="registry-title">
<div class="section-container registry-hero">
    <div class="registry-hero-copy">
        <p class="eyebrow">{{ locale == 'fr' ? 'Registre public de packages · v2' : 'Public package registry · v2' }}</p>
        <h1 id="registry-title">{{ locale == 'fr' ? 'Construisez' : 'Build it' }}<br><span>{{ locale == 'fr' ? 'Publiez' : 'Release it' }}</span><br>{{ locale == 'fr' ? 'Partagez' : 'Share it' }}</h1>
        <p class="lede">{{ locale == 'fr' ? 'Silex grandit grâce aux logiciels qui fonctionnent. Améliorez le langage, renforcez ses packages ou publiez une capacité réutilisable.' : 'Silex grows through working software. Improve the language, strengthen its packages, or publish a reusable capability.' }}</p>
        <div class="actions">
            <a class="button button-primary" href="#publish">{{ locale == 'fr' ? 'Publier un package' : 'Publish a package' }}</a>
            <a class="button button-secondary" href="/{{ locale }}/packages">{{ locale == 'fr' ? 'Voir les packages' : 'Browse packages' }}</a>
        </div>
    </div>

    <aside class="registry-card" aria-labelledby="registry-card-title">
        <div class="registry-card-titlebar">
            <span class="status-dot" aria-hidden="true"></span>
            <strong id="registry-card-title">registry.silex-lang.org</strong>
            <span>API</span>
        </div>
        <dl class="registry-facts">
            <div><dt>Format</dt><dd>JSON API</dd></div>
            <div><dt>{{ locale == 'fr' ? 'Stockage' : 'Storage' }}</dt><dd>Cloudflare D1 + R2</dd></div>
            <div><dt>Versions</dt><dd>{{ locale == 'fr' ? 'Instantanés immuables' : 'Immutable snapshots' }}</dd></div>
        </dl>
        <a class="registry-endpoint" href="https://registry.silex-lang.org/v2/catalog">
            <span>GET</span><code>/v2/catalog</code><b aria-hidden="true">→</b>
        </a>
    </aside>
</div>
</section>

<section class="registry-section registry-contribute-section" id="contribute" aria-labelledby="contribute-title">
<div class="section-container">
    <div class="registry-heading registry-heading-split">
        <div><p class="eyebrow section-tag">{{ locale == 'fr' ? 'Choisissez votre contribution' : 'Choose your contribution' }}</p><h2 id="contribute-title">{{ locale == 'fr' ? 'Faites avancer Silex' : 'Move Silex forward' }}</h2></div>
        <p>{{ locale == 'fr' ? 'Partez d’un besoin concret. Une correction ciblée, un exemple lisible ou un petit package peut améliorer toute l’expérience de développement.' : 'Start from a concrete need. A focused fix, a readable example, or a small package can improve the whole developer experience.' }}</p>
    </div>

    {% set contributions = locale == 'fr' ? [
        ['01', 'Langage et toolchain', 'Améliorez les diagnostics, la sémantique, la compilation native, les outils ou les exemples qui prouvent une fonctionnalité.', 'Explorer Silex', 'https://github.com/Matanek/Silex'],
        ['02', 'Packages officiels', 'Renforcez la bibliothèque standard ou la pile applicative GFX avec des API publiques orientées intention.', 'Explorer les packages', '/' ~ locale ~ '/#packages'],
        ['03', 'Packages communautaires', 'Publiez un instantané local avec Silex ; un dépôt public peut servir de lien pour contribuer.', 'Voir le parcours', '#publish']
    ] : [
        ['01', 'Language & toolchain', 'Improve diagnostics, semantics, native compilation, tooling, or the examples that prove a feature works.', 'Explore Silex', 'https://github.com/Matanek/Silex'],
        ['02', 'Official packages', 'Strengthen the standard library or the GFX application stack through intention-oriented public APIs.', 'Explore packages', '/' ~ locale ~ '/#packages'],
        ['03', 'Community packages', 'Publish a local snapshot with Silex; a public repository can be linked for contributions.', 'Read the release path', '#publish']
    ] %}
    <div class="contribution-grid">
        {% for contribution in contributions %}
            <article class="contribution-card">
                <span class="card-number">{{ contribution[0] }}</span>
                <h3>{{ contribution[1] }}</h3>
                <p>{{ contribution[2] }}</p>
                <a href="{{ contribution[4] }}">{{ contribution[3] }} <span aria-hidden="true">→</span></a>
            </article>
        {% endfor %}
    </div>
</div>
</section>

<section class="registry-section registry-publish-section" id="publish" aria-labelledby="publish-title">
<div class="section-container">
    <div class="registry-heading registry-heading-split publish-heading">
        <div><p class="eyebrow section-tag">{{ locale == 'fr' ? 'Publier un package' : 'Publish a package' }}</p><h2 id="publish-title">{{ locale == 'fr' ? 'Publiez votre package' : 'Publish your package' }}</h2></div>
        <p>{% if locale == 'fr' %}Connectez-vous avec GitHub pour prouver votre identité, puis publiez les fichiers locaux avec <code>silex publish</code>. Le registre conserve l’archive et les artefacts sur Cloudflare. Aucun dépôt Git n’est requis.{% else %}Sign in with GitHub to verify your identity, then publish local files with <code>silex publish</code>. The registry stores the archive and artifacts on Cloudflare. No Git repository is required.{% endif %}</p>
    </div>

    {% set steps = locale == 'fr' ? [
        ['01', 'Préparer le package', 'Définissez son nom, sa version et la compatibilité Silex dans Package.json.', null, null],
        ['02', 'Prévisualiser', 'Lancez', 'silex publish chemin/du/Package --dry-run', ' pour vérifier les fichiers et artefacts inclus.'],
        ['03', 'Se connecter', 'Autorisez votre identité GitHub avec', 'silex login', '. La connexion dure 30 jours et peut être renouvelée lors d’une publication, au plus jusqu’à 90 jours.'],
        ['04', 'Publier', 'Envoyez cet instantané avec', 'silex publish chemin/du/Package', '. Les utilisateurs l’installent ensuite depuis Cloudflare.']
    ] : [
        ['01', 'Prepare the package', 'Set its name, version, and Silex compatibility in Package.json.', null, null],
        ['02', 'Preview', 'Run', 'silex publish path/to/Package --dry-run', ' to inspect included files and artifacts.'],
        ['03', 'Sign in', 'Authorize your GitHub identity with', 'silex login', '. Access lasts 30 days and can renew during publication, up to 90 days total.'],
        ['04', 'Publish', 'Upload this snapshot with', 'silex publish path/to/Package', '. Users then install it from Cloudflare.']
    ] %}
    <div class="publish-layout">
        <ol class="release-steps">
            {% for step in steps %}
                <li>
                    <span>{{ step[0] }}</span>
                    <div><h3>{{ step[1] }}</h3><p>{{ step[2] }}{% if step[3] %} <code>{{ step[3] }}</code>{% endif %}{% if step[4] %}{{ step[4] }}{% endif %}</p></div>
                </li>
            {% endfor %}
        </ol>

        <div class="manifest-window" aria-label="{{ locale == 'fr' ? 'Publier un package avec la ligne de commande Silex' : 'Publish a package with the Silex command line' }}">
            <div class="registry-card-titlebar"><span class="file-mark" aria-hidden="true">$</span><strong>Example 1.0.0</strong></div>
            <pre><code><span class="key">$</span> silex publish Packages/Example --dry-run
<span class="value">silex: dry run for Example@1.0.0 (nothing uploaded)</span>

<span class="key">$</span> silex login
<span class="key">$</span> silex publish Packages/Example
<span class="value">silex: published Example@1.0.0</span></code></pre>
            <a href="https://registry.silex-lang.org/v2/capabilities">{{ locale == 'fr' ? 'Vérifier le registre public' : 'Check the public registry' }} <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <aside class="registry-review" aria-labelledby="registry-review-title">
        <div class="registry-review-copy">
            <h3 class="eyebrow" id="registry-review-title">{{ locale == 'fr' ? 'Versions publiées' : 'Published versions' }}</h3>
            <p>{% if locale == 'fr' %}Chaque version reste disponible même si le dépôt de développement disparaît. Un lien GitHub facultatif peut aider les personnes qui veulent contribuer.{% else %}Each version remains available even if its development repository disappears. An optional GitHub link can help contributors.{% endif %}</p>
        </div>
        <a class="button button-secondary" href="/{{ locale }}/packages">{{ locale == 'fr' ? 'Explorer les packages' : 'Browse packages' }}</a>
    </aside>
</div>
</section>
{% endblock %}
