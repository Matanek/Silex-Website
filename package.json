{
  "name": "silex-web",
  "private": true,
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run build:css && npm run build:syntax",
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./public/assets/app.css --minify",
    "build:syntax": "node scripts/build-syntax-highlighting.mjs",
    "content:build": "node scripts/build-content-snapshot.mjs",
    "content:fetch": "node scripts/fetch-content-sources.mjs",
    "dev": "tailwindcss -i ./assets/css/app.css -o ./public/assets/app.css --watch",
    "dev:syntax": "node scripts/build-syntax-highlighting.mjs --watch"
  },
  "devDependencies": {
    "@shikijs/core": "4.4.2",
    "@shikijs/engine-javascript": "4.4.2",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "0.25.9",
    "tailwindcss": "^4.1.0"
  }
}
